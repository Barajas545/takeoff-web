# ── never publish ─────────────────────────────────────────────────────────
#
# The HARNESSES are committed: they take their paths from the environment
# (tests/config.mjs) and skip when the data is not there, so a fresh clone can
# run everything that does not need one particular machine's files.
#
# What must never be published is the DATA they run against.

# Real project files from real jobs — a named client's whole stamped plan set
# among them. tests/data/ is the committed, anonymised counterpart.
tests/fixtures/

# A local override of the library and desktop-source paths, if anyone prefers
# a file to environment variables.
tests/config.local.mjs

# Captured output from a run against the real library: it carries project
# names, client names and source PDF filenames.
tests/*-truth.json
!tests/catalog-python-truth.json
tests/out/

# docs/spec/ is the desktop program specified back out of its source: the
# file format, the measurement schema, the scale maths, the tool behaviour.
# docs/PORTAL-EMBED.md describes internal company infrastructure.
docs/

# a local convenience that runs the dev server in tests/
start.bat

# ── ordinary noise ────────────────────────────────────────────────────────
.claude/
node_modules/
*.tgz
.DS_Store
Thumbs.db
*.takeoff
*.pdfcache

# the internal build notes stay local
README.dev.md
